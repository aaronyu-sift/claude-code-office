{
  "name": "claude-code-office",
  "version": "0.1.0",
  "description": "Live dashboard, 3D isometric office and cost tracker for your local Claude Code sessions and subagents. Zero dependencies, runs on localhost.",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "ai-agents",
    "subagents",
    "dashboard",
    "visualizer",
    "observability",
    "monitoring",
    "token-usage",
    "cost-tracker",
    "isometric",
    "threejs",
    "developer-tools",
    "localhost"
  ],
  "homepage": "https://github.com/azorkai/claude-code-office#readme",
  "bugs": {
    "url": "https://github.com/azorkai/claude-code-office/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azorkai/claude-code-office.git"
  },
  "license": "MIT",
  "author": "azorkai",
  "main": "server.js",
  "bin": {
    "claude-code-office": "bin/claude-code-office.js"
  },
  "files": [
    "bin/",
    "public/",
    "server.js",
    "cost-worker.js",
    "demo.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node server.js --open",
    "demo": "node server.js --demo --open",
    "vendor": "npx esbuild node_modules/three/build/three.module.js --bundle --minify --format=esm --outfile=public/vendor/three/three.module.min.js && node -e \"const fs=require('fs');fs.mkdirSync('public/vendor/three/addons/geometries',{recursive:true});fs.copyFileSync('node_modules/three/examples/jsm/geometries/RoundedBoxGeometry.js','public/vendor/three/addons/geometries/RoundedBoxGeometry.js');fs.copyFileSync('node_modules/three/LICENSE','public/vendor/three/LICENSE')\"",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/",
    "chat:check": "node tools/check-chat-contract.mjs",
    "qa:3d-env": "node tools/qa/office3d-env-qa.mjs",
    "qa:pixel": "node tools/qa/pixel-qa.mjs",
    "qa:3d": "node tools/qa/office3d-qa.mjs",
    "qa:3d-life": "node tools/qa/office3d-life-qa.mjs",
    "qa:3d-ui": "node tools/qa/office3d-ui-qa.mjs",
    "qa:progress": "node tools/qa/office-progress-qa.mjs",
    "qa:chrome-leak": "node tools/qa/cdp-leak-check.mjs",
    "qa:board": "node tools/qa/office-board-qa.mjs",
    "qa:settings-tab": "node tools/qa/office-settings-tab-qa.mjs",
    "sprites": "node tools/sprites/build-atlas.mjs --proj iso",
    "sprites:check": "node tools/sprites/build-atlas.mjs --proj iso --check",
    "sprites:table": "node tools/sprites/content-table.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "three": "^0.186.1"
  }
}
